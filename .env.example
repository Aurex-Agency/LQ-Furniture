# Inbound webhook that receives text list sign-ups (GoHighLevel workflow
# trigger). Set the real value in the Vercel project's environment
# variables, not in the repo: anyone holding this URL can push contacts
# into the CRM.
GHL_SMS_WEBHOOK_URL=

# Resend transactional email for the contact form (/api/contact).
# Create the key at resend.com. Set the real values in the Vercel project's
# environment variables, not in the repo.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend. Until a domain is
# verified, the only accepted sender is Resend's sandbox, onboarding@resend.dev,
# which can ONLY deliver to the Resend account owner's own address.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
