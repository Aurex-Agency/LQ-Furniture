# Inbound webhook that receives text list sign-ups (GoHighLevel workflow
# trigger). Set the real value in the Vercel project's environment
# variables, not in the repo: anyone holding this URL can push contacts
# into the CRM.
GHL_SMS_WEBHOOK_URL=

# Resend transactional email for the contact form (/api/contact).
# Create the key at resend.com. Set the real values in the Vercel project's
# environment variables, not in the repo.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend AND a domain this
# particular API key is authorised for. Those are two different things: a
# restricted key is scoped to one domain and returns 403 for every other one,
# even domains that are verified in the dashboard.
#
# A bare address gets a display name added automatically. Set the whole
# "Name <address>" form here to override, or set CONTACT_FROM_NAME.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Display name on the From header. Defaults to "LQ Furniture Website".
# Ignored when CONTACT_FROM_EMAIL already includes a display name.
CONTACT_FROM_NAME=

# Where contact form messages are delivered. The store's address is
# info@lqfurniture.com, so that is what this should be set to in Vercel; it is
# deliberately left empty here rather than defaulted in code, because the
# sandbox sender above cannot deliver to it until lqfurniture.com is verified
# in Resend. Accepts a comma-separated list for more than one recipient.
CONTACT_TO_EMAIL=
